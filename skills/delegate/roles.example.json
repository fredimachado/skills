{
  "$comment": "Copy to ~/.agents/roles.json and fill in, or let scripts/install.ps1 -Roles (install.sh --roles) ask and write it. harness is claude, codex or cursor. model is the id or alias that harness accepts. effort is optional. Each role can have one fallback for usage quota exhaustion. hostOverrides.<host>.<role> replaces the whole role, including its fallback.",
  "roles": {
    "planner": {
      "harness": "claude",
      "model": "<model id>",
      "effort": "<level>",
      "fallback": { "harness": "codex", "model": "<model id>", "effort": "<level>" }
    },
    "coder-simple":  { "harness": "<claude|codex|cursor>", "model": "<model id>", "effort": "<level>" },
    "coder-complex": { "harness": "<claude|codex|cursor>", "model": "<model id>", "effort": "<level>" },
    "reviewer":      { "harness": "<claude|codex|cursor>", "model": "<model id>", "effort": "<level>" },
    "council-a":     { "harness": "<claude|codex|cursor>", "model": "<model id>", "effort": "<level>" },
    "council-b":     { "harness": "<claude|codex|cursor>", "model": "<model id>", "effort": "<level>" }
  },
  "hostOverrides": {
    "cursor": {
      "coder-simple": { "harness": "cursor", "model": "<model id>" }
    }
  }
}
