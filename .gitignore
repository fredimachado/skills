# This repository may be cloned into a folder where skills are installed, such as
# ~/.agents/skills: then install.ps1/install.sh links and APM put skill folders next to
# these files. Track only what belongs to the repository.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/apm/
!/archive/
!/scripts/
!/skills/
!/tests/
